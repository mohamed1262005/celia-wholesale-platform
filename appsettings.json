{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cache": {
    "Redis": {
      "ConnectionString": "localhost:6379",
      "InstanceName": "celia-cache:"
    },
    "ProductList": {
      "AbsoluteMinutes": 15,
      "SlidingMinutes": 5
    },
    "ProductDetail": {
      "AbsoluteHours": 12,
      "SlidingMinutes": 30
    },
    "CategoryList": {
      "AbsoluteHours": 24,
      "SlidingMinutes": 15
    }
  }
}
